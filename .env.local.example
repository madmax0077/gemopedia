# -----------------------------------------------------------------------------
# Gemopedia — local environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (git-ignored) and fill in your own values.
# For production, set the same variables in Vercel:
#   Project Settings → Environment Variables → add for Production/Preview/Development
# -----------------------------------------------------------------------------

# Google Analytics 4 Measurement ID (starts with "G-")
# Get yours at https://analytics.google.com → Admin → Data Streams → Web
# Leave empty to disable GA in local dev.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# IndexNow key (used by scripts/notify-indexnow.mjs).
# Only needed if you run the notifier locally; CI already has it hard-coded.
# INDEXNOW_KEY=85f339b64ac4ab92a0a387fda539513f
# SITE_URL=https://www.gemopedia.online
