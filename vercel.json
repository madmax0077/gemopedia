    {
      "source": "/compare",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400, must-revalidate" }]
    },
    {
      "source": "/compare/:pair*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400, must-revalidate" }]
    },
    {
      "source": "/learn",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400, must-revalidate" }]
    }
  ]
}
